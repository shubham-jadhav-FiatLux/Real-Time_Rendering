
layout(vertices=4) out;
in vec2 out_a_texcoord[];
uniform mat4 u_modelMatrix;
uniform mat4 u_viewMatrix;

out vec2 tcs_texcoord_out[];
void main(void)
{
	mat4 u_mvpMatrix = u_viewMatrix * u_modelMatrix;

	gl_out[gl_InvocationID].gl_Position = gl_in[gl_InvocationID].gl_Position;
	tcs_texcoord_out[gl_InvocationID] = out_a_texcoord[gl_InvocationID];

	if (gl_InvocationID == 0)
	{
		const int MIN_TESS_LEVEL = 4;
        const int MAX_TESS_LEVEL = 64;
        const float MIN_DISTANCE = 0;
        const float MAX_DISTANCE = 1;

		vec4 p0 = u_mvpMatrix * gl_in[0].gl_Position;
		vec4 p1 = u_mvpMatrix * gl_in[1].gl_Position;
		vec4 p2 = u_mvpMatrix * gl_in[2].gl_Position;
		vec4 p3 = u_mvpMatrix * gl_in[3].gl_Position;

		float distance00 = clamp((abs(p0.z) - MIN_DISTANCE) / (MAX_DISTANCE-MIN_DISTANCE), 0.0, 1.0);
		float distance01 = clamp((abs(p1.z) - MIN_DISTANCE) / (MAX_DISTANCE-MIN_DISTANCE), 0.0, 1.0);
		float distance10 = clamp((abs(p2.z) - MIN_DISTANCE) / (MAX_DISTANCE-MIN_DISTANCE), 0.0, 1.0);
		float distance11 = clamp((abs(p3.z) - MIN_DISTANCE) / (MAX_DISTANCE-MIN_DISTANCE), 0.0, 1.0);
		
		float l0 = mix(MAX_TESS_LEVEL, MIN_TESS_LEVEL, min(distance10, distance00));
		float l1 = mix(MAX_TESS_LEVEL, MIN_TESS_LEVEL, min(distance00, distance01));
		float l2 = mix(MAX_TESS_LEVEL, MIN_TESS_LEVEL, min(distance01, distance11));
		float l3 = mix(MAX_TESS_LEVEL, MIN_TESS_LEVEL, min(distance11, distance10));

		gl_TessLevelOuter[0] = l0;
		gl_TessLevelOuter[1] = l1;
		gl_TessLevelOuter[2] = l2;
		gl_TessLevelOuter[3] = l3;
		
		gl_TessLevelInner[0] = min(l1, l3);
		gl_TessLevelInner[1] = min(l0, l2);
	}	
};
